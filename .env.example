# Used by docker-compose.yml. Copy to .env to override the local-dev defaults.
#
# These values are placed straight into DATABASE_URL (a URL), and Compose can't
# URL-encode them. Stick to letters, digits, '-', '_' and '.'. Characters like
# # @ : / ? % would break the connection URL.
#
# Postgres only reads them when it creates a new data volume. If you change
# them after the first `docker compose up`, either reset the volume
# (`docker compose down -v`, this deletes local DB data) or update the existing
# DB to match (ALTER USER ... PASSWORD, etc.).
POSTGRES_DB=atelier
POSTGRES_USER=atelier_user
POSTGRES_PASSWORD=atelier_password
